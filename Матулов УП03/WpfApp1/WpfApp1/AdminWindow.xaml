<Window x:Class="WpfApp1.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Администратор" Height="700" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="#F3EFF5">
    <TabControl Margin="8" Background="#F3EFF5" BorderBrush="#C9BBCF">
        <TabItem Header="Пользователи">
            <Grid Margin="12" Background="#F3EFF5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#2B2233"/>
                    <TextBox x:Name="SearchBOX" Width="220" TextChanged="UserFilterChanged"
                             Padding="4" Background="#FBF9FC" BorderBrush="#C9BBCF"/>
                    <TextBlock x:Name="InfoLBL" VerticalAlignment="Center" Margin="15,0,0,0"
                               Foreground="#2B2233"/>
                </StackPanel>
                <DataGrid x:Name="UsersGRD" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          Background="#FBF9FC" BorderBrush="#C9BBCF"
                          RowBackground="#FBF9FC" AlternatingRowBackground="#F3EFF5"
                          SelectionChanged="UsersGRD_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150"/>
                        <DataGridTextColumn Header="Роль" Binding="{Binding RolRu}" Width="150"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="130"/>
                        <DataGridTextColumn Header="Дата регистрации" Binding="{Binding DataSozdaniya, StringFormat=dd.MM.yyyy HH:mm}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="ToggleBlockBTN" Content="Заблокировать" Width="120" Height="28" Margin="0,0,8,0"
                            Background="#A56B8F" Foreground="White" BorderBrush="#7E4F6B"
                            IsEnabled="False"
                            Click="ToggleBlockBTN_Click"/>
                    <Button x:Name="DelUserBTN" Content="Удалить" Width="120" Height="28"
                            Background="#A56B8F" Foreground="White" BorderBrush="#7E4F6B"
                            IsEnabled="False"
                            Click="DelUserBTN_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Группы">
            <Grid Margin="12" Background="#F3EFF5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Номер класса:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#2B2233"/>
                    <TextBox x:Name="GruppaNomerBOX" Width="70" Margin="0,0,15,0"
                             Padding="4" Background="#FBF9FC" BorderBrush="#C9BBCF"/>
                    <TextBlock Text="Буква:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#2B2233"/>
                    <TextBox x:Name="GruppaBukvaBOX" Width="50" Margin="0,0,20,0"
                             Padding="4" Background="#FBF9FC" BorderBrush="#C9BBCF"/>
                    <Button Content="Добавить" Width="120" Height="28" Margin="0,0,8,0"
                            Background="#7C9070" Foreground="White" BorderBrush="#5B6E52"
                            Click="AddGruppaBTN_Click"/>
                    <Button Content="Удалить" Width="120" Height="28"
                            Background="#A56B8F" Foreground="White" BorderBrush="#7E4F6B"
                            Click="DelGruppaBTN_Click"/>
                </StackPanel>
                <DataGrid x:Name="GruppyGRD" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          Background="#FBF9FC" BorderBrush="#C9BBCF"
                          RowBackground="#FBF9FC" AlternatingRowBackground="#F3EFF5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="Класс" Binding="{Binding NomerKlassa}" Width="80"/>
                        <DataGridTextColumn Header="Буква" Binding="{Binding BukvaKlassa}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Дисциплины">
            <Grid Margin="12" Background="#F3EFF5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Название:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#2B2233"/>
                    <TextBox x:Name="DiscNazvBOX" Width="180" Margin="0,0,15,0"
                             Padding="4" Background="#FBF9FC" BorderBrush="#C9BBCF"/>
                    <TextBlock Text="Описание:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#2B2233"/>
                    <TextBox x:Name="DiscOpisBOX" Width="280" Margin="0,0,20,0"
                             Padding="4" Background="#FBF9FC" BorderBrush="#C9BBCF"/>
                    <Button Content="Добавить" Width="120" Height="28" Margin="0,0,8,0"
                            Background="#7C9070" Foreground="White" BorderBrush="#5B6E52"
                            Click="AddDiscBTN_Click"/>
                    <Button Content="Удалить" Width="120" Height="28"
                            Background="#A56B8F" Foreground="White" BorderBrush="#7E4F6B"
                            Click="DelDiscBTN_Click"/>
                </StackPanel>
                <DataGrid x:Name="DiscGRD" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          Background="#FBF9FC" BorderBrush="#C9BBCF"
                          RowBackground="#FBF9FC" AlternatingRowBackground="#F3EFF5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Nazvanie}" Width="220"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Opisanie}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Преподаватели">
            <Grid Margin="12" Background="#F3EFF5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Пользователь:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#2B2233"/>
                    <ComboBox x:Name="PrepUserCMB" Width="180" Margin="0,0,15,0"/>
                    <TextBlock Text="ФИО:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#2B2233"/>
                    <TextBox x:Name="PrepFioBOX" Width="230" Margin="0,0,20,0"
                             Padding="4" Background="#FBF9FC" BorderBrush="#C9BBCF"/>
                    <Button Content="Добавить" Width="120" Height="28" Margin="0,0,8,0"
                            Background="#7C9070" Foreground="White" BorderBrush="#5B6E52"
                            Click="AddPrepBTN_Click"/>
                    <Button Content="Удалить" Width="120" Height="28"
                            Background="#A56B8F" Foreground="White" BorderBrush="#7E4F6B"
                            Click="DelPrepBTN_Click"/>
                </StackPanel>
                <DataGrid x:Name="PrepGRD" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          Background="#FBF9FC" BorderBrush="#C9BBCF"
                          RowBackground="#FBF9FC" AlternatingRowBackground="#F3EFF5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="polzovatel_id" Binding="{Binding PolzovatelId}" Width="120"/>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150"/>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding Fio}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Курсы">
            <Grid Margin="12" Background="#F3EFF5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Название:" VerticalAlignment="Center" Width="110" Foreground="#2B2233"/>
                        <TextBox x:Name="KursNazvBOX" Width="280" Padding="4"
                                 Background="#FBF9FC" BorderBrush="#C9BBCF"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Дисциплина:" VerticalAlignment="Center" Width="110" Foreground="#2B2233"/>
                        <ComboBox x:Name="KursDiscCMB" Width="280"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Преподаватель:" VerticalAlignment="Center" Width="110" Foreground="#2B2233"/>
                        <ComboBox x:Name="KursPrepCMB" Width="280"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Изображение:" VerticalAlignment="Center" Width="110" Foreground="#2B2233"/>
                        <TextBox x:Name="KursImageBOX" Width="280" Padding="4" IsReadOnly="True"
                                 Background="#FBF9FC" BorderBrush="#C9BBCF" Margin="0,0,8,0"/>
                        <Button Content="Обзор" Width="120" Height="28"
                                Background="#7C9070" Foreground="White" BorderBrush="#5B6E52"
                                Click="ChooseImageBTN_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Описание:" VerticalAlignment="Center" Width="110" Foreground="#2B2233"/>
                        <TextBox x:Name="KursOpisBOX" Width="450" Height="45" TextWrapping="Wrap"
                                 AcceptsReturn="True" Padding="4"
                                 Background="#FBF9FC" BorderBrush="#C9BBCF"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="110,10,0,0">
                        <Button Content="Добавить" Width="120" Height="28" Margin="0,0,8,0"
                                Background="#7C9070" Foreground="White" BorderBrush="#5B6E52"
                                Click="AddKursBTN_Click"/>
                        <Button Content="Удалить" Width="120" Height="28"
                                Background="#A56B8F" Foreground="White" BorderBrush="#7E4F6B"
                                Click="DelKursBTN_Click"/>
                    </StackPanel>
                </StackPanel>
                <DataGrid x:Name="KursGRD" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          Background="#FBF9FC" BorderBrush="#C9BBCF"
                          RowBackground="#FBF9FC" AlternatingRowBackground="#F3EFF5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Nazvanie}" Width="220"/>
                        <DataGridTextColumn Header="Дисциплина" Binding="{Binding DiscName}" Width="150"/>
                        <DataGridTextColumn Header="Преподаватель" Binding="{Binding PrepName}" Width="200"/>
                        <DataGridTextColumn Header="Создан" Binding="{Binding DataSozdaniya, StringFormat=dd.MM.yyyy}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Импорт XML">
            <Grid Margin="12" Background="#F3EFF5">
                <StackPanel>
                    <TextBlock Text="Импорт пользователей из XML" Foreground="#2B2233" Margin="0,0,0,8"/>
                    <Button Content="Выбрать файл" Width="120" Height="28" HorizontalAlignment="Left"
                            Background="#7C9070" Foreground="White" BorderBrush="#5B6E52"
                            Click="ImportUsersBTN_Click"/>
                    <TextBlock x:Name="ImportUsersInfo" Foreground="#2B2233" Margin="0,10,0,25"/>

                    <TextBlock Text="Импорт курсов из XML" Foreground="#2B2233" Margin="0,0,0,8"/>
                    <Button Content="Выбрать файл" Width="120" Height="28" HorizontalAlignment="Left"
                            Background="#7C9070" Foreground="White" BorderBrush="#5B6E52"
                            Click="ImportCoursesBTN_Click"/>
                    <TextBlock x:Name="ImportCoursesInfo" Foreground="#2B2233" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Выход">
            <Grid Margin="12" Background="#F3EFF5">
                <Button Content="Выйти из системы" Width="120" Height="28"
                        Background="#A56B8F" Foreground="White" BorderBrush="#7E4F6B"
                        Click="ExitBTN_Click"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>