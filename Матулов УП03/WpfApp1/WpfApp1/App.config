<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <!--
        Параметры подключения к базе данных SQL Server.

        В репозитории хранится только обезличенная схема: пароль заменён на CHANGE_ME,
        чтобы действующие учётные данные сервера не попадали в открытый репозиторий.

        Реальные параметры подключения задаются одним из двух способов:
          1) в файле App.config.local рядом с исполняемым файлом WpfApp1.exe
             (этот файл не входит в репозиторий);
          2) непосредственно в разделе connectionStrings файла WpfApp1.exe.config.
    -->
    <connectionStrings>
        <add name="DefaultConnection"
             connectionString="Server=stud-mssql.sttec.yar.ru,38325;Database=user87_db;User Id=user87_db;Password=CHANGE_ME;"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
