<Window x:Class="WpfApp1.TeacherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учитель" Height="700" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="#F3EFF5">
    <TabControl Margin="8" Background="#F3EFF5" BorderBrush="#C9BBCF">
        <TabItem Header="Мои курсы">
            <Grid Margin="12" Background="#F3EFF5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="InfoLBL" Foreground="#2B2233" Margin="0,0,0,12"/>
                <DataGrid x:Name="MyKursGRD" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          Background="#FBF9FC" BorderBrush="#C9BBCF"
                          RowBackground="#FBF9FC" AlternatingRowBackground="#F3EFF5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Курс" Binding="{Binding Nazvanie}" Width="260"/>
                        <DataGridTextColumn Header="Дисциплина" Binding="{Binding DiscName}" Width="180"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Opisanie}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Создать курс">
            <Grid Margin="12" Background="#F3EFF5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Название:" VerticalAlignment="Center" Width="110" Foreground="#2B2233"/>
                        <TextBox x:Name="KursNazvBOX" Width="350" Padding="4"
                                 Background="#FBF9FC" BorderBrush="#C9BBCF"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Дисциплина:" VerticalAlignment="Center" Width="110" Foreground="#2B2233"/>
                        <ComboBox x:Name="KursDiscCMB" Width="350"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Изображение:" VerticalAlignment="Center" Width="110" Foreground="#2B2233"/>
                        <TextBox x:Name="KursImageBOX" Width="280" Padding="4" IsReadOnly="True"
                                 Background="#FBF9FC" BorderBrush="#C9BBCF" Margin="0,0,8,0"/>
                        <Button Content="Обзор" Width="120" Height="28"
                                Background="#7C9070" Foreground="White" BorderBrush="#5B6E52"
                                Click="ChooseImageBTN_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Описание:" VerticalAlignment="Top" Width="110"
                                   Foreground="#2B2233" Margin="0,5,0,0"/>
                        <TextBox x:Name="KursOpisBOX" Width="450" Height="60" TextWrapping="Wrap"
                                 AcceptsReturn="True" Padding="4"
                                 Background="#FBF9FC" BorderBrush="#C9BBCF"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="110,10,0,0">
                        <Button Content="Создать" Width="120" Height="28"
                                Background="#7C9070" Foreground="White" BorderBrush="#5B6E52"
                                Click="AddKursBTN_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Создать задание">
            <Grid Margin="12" Background="#F3EFF5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Курс:" VerticalAlignment="Center" Width="110" Foreground="#2B2233"/>
                        <ComboBox x:Name="ZadKursCMB" Width="350"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Название:" VerticalAlignment="Center" Width="110" Foreground="#2B2233"/>
                        <TextBox x:Name="ZadNazvBOX" Width="350" Padding="4"
                                 Background="#FBF9FC" BorderBrush="#C9BBCF"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Описание:" VerticalAlignment="Top" Width="110"
                                   Foreground="#2B2233" Margin="0,5,0,0"/>
                        <TextBox x:Name="ZadOpisBOX" Width="450" Height="60" TextWrapping="Wrap"
                                 AcceptsReturn="True" Padding="4"
                                 Background="#FBF9FC" BorderBrush="#C9BBCF"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Срок сдачи:" VerticalAlignment="Center" Width="110" Foreground="#2B2233"/>
                        <DatePicker x:Name="ZadDatePicker" Width="180"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Макс. балл:" VerticalAlignment="Center" Width="110" Foreground="#2B2233"/>
                        <TextBox x:Name="ZadBallBOX" Width="80" Padding="4" Text="100"
                                 Background="#FBF9FC" BorderBrush="#C9BBCF"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="110,10,0,0">
                        <Button Content="Создать" Width="120" Height="28"
                                Background="#7C9070" Foreground="White" BorderBrush="#5B6E52"
                                Click="AddZadBTN_Click"/>
                    </StackPanel>
                </StackPanel>
                <DataGrid x:Name="ZadGRD" Grid.Row="1" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          Background="#FBF9FC" BorderBrush="#C9BBCF"
                          RowBackground="#FBF9FC" AlternatingRowBackground="#F3EFF5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Курс" Binding="{Binding KursName}" Width="220"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Nazvanie}" Width="220"/>
                        <DataGridTextColumn Header="Срок сдачи" Binding="{Binding SrokSdachi, StringFormat=dd.MM.yyyy}" Width="130"/>
                        <DataGridTextColumn Header="Макс. балл" Binding="{Binding MaksBall}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="На проверку">
            <Grid Margin="12" Background="#F3EFF5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="CheckGRD" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False"
                          Background="#FBF9FC" BorderBrush="#C9BBCF"
                          RowBackground="#FBF9FC" AlternatingRowBackground="#F3EFF5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                        <DataGridTextColumn Header="Курс" Binding="{Binding KursName}" Width="150"/>
                        <DataGridTextColumn Header="Задание" Binding="{Binding ZadName}" Width="170"/>
                        <DataGridTextColumn Header="Ученик" Binding="{Binding UchenikName}" Width="160"/>
                        <DataGridTextColumn Header="Дата сдачи" Binding="{Binding DataSdachi, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                        <DataGridTextColumn Header="Ответ" Binding="{Binding Otvet}" Width="220"/>
                        <DataGridTextColumn Header="Макс. балл" Binding="{Binding MaksBall}" Width="90"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusRu}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0">
                    <TextBlock Text="Балл:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#2B2233"/>
                    <TextBox x:Name="BallBOX" Width="70" Margin="0,0,20,0" Padding="4"
                             Background="#FBF9FC" BorderBrush="#C9BBCF"/>
                    <TextBlock Text="Комментарий:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#2B2233"/>
                    <TextBox x:Name="CommentBOX" Width="400" Margin="0,0,20,0" Padding="4"
                             Background="#FBF9FC" BorderBrush="#C9BBCF"/>
                    <Button Content="Сохранить" Width="120" Height="28"
                            Background="#7C9070" Foreground="White" BorderBrush="#5B6E52"
                            Click="SaveBallBTN_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Ведомость">
            <Grid Margin="12" Background="#F3EFF5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Курс:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#2B2233"/>
                    <ComboBox x:Name="VedKursCMB" Width="280" SelectionChanged="VedKursCMB_SelectionChanged"/>
                </StackPanel>
                <DataGrid x:Name="VedGRD" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False"
                          Background="#FBF9FC" BorderBrush="#C9BBCF"
                          RowBackground="#FBF9FC" AlternatingRowBackground="#F3EFF5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ученик" Binding="{Binding UchenikName}" Width="250"/>
                        <DataGridTextColumn Header="Задание" Binding="{Binding ZadName}" Width="250"/>
                        <DataGridTextColumn Header="Балл" Binding="{Binding Ball}" Width="100"/>
                        <DataGridTextColumn Header="Комментарий" Binding="{Binding Kommentariy}" Width="300"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusRu}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                    <Button Content="Печать" Width="120" Height="28"
                            Background="#7C9070" Foreground="White" BorderBrush="#5B6E52"
                            Click="PrintVedBTN_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Выход">
            <Grid Margin="12" Background="#F3EFF5">
                <Button Content="Выйти из системы" Width="120" Height="28"
                        Background="#A56B8F" Foreground="White" BorderBrush="#7E4F6B"
                        Click="ExitBTN_Click"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>